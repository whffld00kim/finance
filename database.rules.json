// finance-manager-ca4ca RTDB 보안 규칙
//
// 모델: allowedUsers/{uid} 에 'admin' 또는 'viewer' 가 있는 계정만 접근한다.
//   admin  = 읽기 + 쓰기
//   viewer = 읽기만
// 허용 계정은 이 파일이 아니라 DB에 둔다 — 이 저장소는 공개라서 uid를 적어두지 않는다.
// 사람을 추가·제거할 때 규칙을 다시 배포할 필요가 없다는 장점도 있다.
//
// firebase CLI(소유자 자격)로 하는 작업은 규칙을 거치지 않는다.
// LifeOS의 볼트 갱신 작업은 종전대로 동작한다.
//
// 여기 없는 경로는 전부 거부된다(기본값). 루트 읽기도 막힌다.
{
  "rules": {

    "allowedUsers": {
      "$uid": {
        // 자기 권한만 확인할 수 있다. 남의 uid나 전체 목록은 못 읽는다.
        ".read": "auth != null && auth.uid == $uid",
        // 권한 부여는 콘솔이나 CLI로만. 앱에서는 못 바꾼다.
        ".write": false
      }
    },

    "finance": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() == 'admin'"
    },

    "stocks": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() == 'admin'"
    },

    "stockDate": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() == 'admin'"
    },

    // 총자산 현황에서 숨긴 행. 화면 설정이라 admin만 서버에 저장한다.
    // viewer가 토글하면 쓰기는 거부되고 localStorage에만 남는다(앱이 이미 그렇게 처리한다).
    "hiddenRows": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() == 'admin'"
    }
  }
}
